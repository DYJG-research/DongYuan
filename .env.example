# ============================================================
# DongYuan Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- LLM API Configuration ---
# OpenAI-compatible API endpoint (local or cloud)
OPENAI_API_KEY=
# Example: OPENAI_API_KEY=sk-your-key-here

# Base URL for the API service (default: http://127.0.0.1:8000/v1)
# LLM_API_BASE_URL=http://127.0.0.1:8000/v1

# --- SSDF-Navigator API ---
# URL for the Navigator prediction service
NAVIGATOR_URL=http://127.0.0.1:8999/predict

# --- SSDF-Core Model ---
# Path to the base model (for training)
# MODEL_PATH=/path/to/your/model

# Output directory for training results
# OUTPUT_DIR=./outputs

# --- Training Configuration ---
# CUDA visible devices (comma-separated)
# CUDA_VISIBLE_DEVICES=0,1,2,3
# Number of processes per node
# NPROC_PER_NODE=4
# Distributed training master port
# MASTER_PORT=29500

# --- Experiment Tracking (Optional) ---
# SwanLab API token (for experiment tracking)
# SWANLAB_TOKEN=your_swanlab_token_here

# --- Data Paths (Override defaults) ---
# INPUT_DIALOGUE_PATH=./data/input_dialogue.json
# OUTPUT_COT_PATH=./data/output_cot.jsonl
# DATASET_DPO=./data/dpo_train_data.jsonl
